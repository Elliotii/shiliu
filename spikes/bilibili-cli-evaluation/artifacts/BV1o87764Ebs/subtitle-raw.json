  {
    "from": 182.69,
    "to": 183.81,
    "content": "没有改一个bug"
  },
  {
    "from": 183.81,
    "to": 185.61,
    "content": "重新部署一下这种好事啊"
  },
  {
    "from": 185.61,
    "to": 188.45,
    "content": "所以整个行业被现实倒逼着"
  },
  {
    "from": 188.45,
    "to": 191.53,
    "content": "把大部分的精力压在了同样一件事情上"
  },
  {
    "from": 191.53,
    "to": 192.97,
    "content": "就是想尽一切办法"
  },
  {
    "from": 192.97,
    "to": 195.13,
    "content": "把所有可能的bug全部都找出来"
  },
  {
    "from": 195.13,
    "to": 197.17,
    "content": "而干这件事情的核心"
  },
  {
    "from": 197.17,
    "to": 199.79,
    "content": "其实不是说你会写芯片代码就行了啊"
