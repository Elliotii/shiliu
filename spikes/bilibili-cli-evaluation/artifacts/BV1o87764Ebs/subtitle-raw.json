  {
    "from": 205.51,
    "to": 207.06,
    "content": "主动把bug暴露出来"
  },
  {
    "from": 207.06,
    "to": 209.0,
    "content": "在哪些地方埋下检查点"
  },
  {
    "from": 209.0,
    "to": 212.29,
    "content": "又怎么样去衡量自己到底测的够不够全"
  },
  {
    "from": 212.29,
    "to": 213.17,
    "content": "讲到这"
  },
  {
    "from": 213.17,
    "to": 214.49,
