    "source_platform": {
      "normalization": "casefolded authoritative mapping platform",
      "required": true
    },
    "source_version": {
      "match": "exact",
      "required": true
    }
  },
  "comparison_policy": {
    "allowed_equivalences": [
      "BVID and authoritative snapshot numeric video ID",
      "segment_id and singleton segment_ids",
      "numeric and string time values within 1e-6 seconds",
      "different selector methods with identical evidence identity",
      "different builder/model versions with identical evidence identity",
      "legacy subtitle-class and generation-lineage labels when stable segment identity is identical"
    ],
    "candidate_id_only_sufficient": false,
    "conservative_non_match_conditions": [
      "different canonical video",
      "different source version",
      "different timeline run",
      "different stable segment identity",
      "AI-generated summary versus segment-backed transcript",
      "time overlap without segment identity"
    ],
    "exact_match_fields": [
      "canonical_video_identity",
      "source_version",
      "canonical_timeline_identity",
      "evidence_form"
    ],
    "normalized_match_fields": [
      "source_platform",
      "video aliases",
      "segment_id/segment_ids",
      "canonical_temporal_interval"
    ],
    "one_to_many_coverage": "same namespace plus union of Runtime segment_ids contains Gold segment_ids and contributing interval envelope covers Gold interval",
    "unverifiable_conditions": [
      "unknown, ambiguous, or conflicting video alias",
      "aid without an authoritative aid mapping",
      "missing video, source_version, timeline_run_id, segment identity, start_time, or end_time",
      "unattested underlying evidence form"
    ]
  },
