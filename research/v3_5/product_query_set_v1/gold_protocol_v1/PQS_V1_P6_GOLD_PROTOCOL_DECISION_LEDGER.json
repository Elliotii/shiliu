      ],
      "downstream_failure_attribution": [
        "RET_NO_ACCEPTABLE_VIDEO_RETRIEVED",
        "RET_UNJUDGED_RETURN_REQUIRES_REVIEW",
        "BLD_GOLD_SOURCE_NOT_IN_CANDIDATE_SET",
        "BLD_REQUIRED_REGION_NOT_IN_CANDIDATE_SET",
        "SEL_ACCEPTABLE_GROUP_AVAILABLE_NOT_SELECTED",
        "SEL_REQUIRED_ASPECT_AVAILABLE_NOT_SELECTED",
        "GATE_INVALID_EVIDENCE_IDENTITY_ACCEPTED",
        "GATE_VALID_EVIDENCE_IDENTITY_REJECTED",
        "JDG_FALSE_SUFFICIENT",
        "JDG_FALSE_PARTIAL",
        "JDG_FALSE_INSUFFICIENT",
        "JDG_FALSE_UNVERIFIABLE",
        "SRC_AUTHORITY_MISSING",
        "SRC_TIMELINE_OR_SEGMENT_IDENTITY_FAILURE"
      ]
    },
    "gold_objects_may_use_downstream_failure_codes": false,
    "downstream_comparison_may_reference_gold_and_prediction": true
  },
  "review_policy": {
    "normal_case_route": [
      "initial_annotation",
      "independent_review"
    ],
    "high_risk_case_route": [
      "initial_annotation",
      "independent_review",
      "second_independent_review_or_user_adjudication"
    ],
    "high_risk_triggers": [
      "no_answer_or_library_gap",
      "partial_status",
      "multi_video_evidence",
      "cross_language_evidence",
      "severe_asr_noise",
      "source_authority_instability",
      "reviewer_disagreement",
      "multiple_acceptable_relevant_videos",
      "required_spans_far_apart",
      "unverifiable_status"
    ],
    "independence_rules": {
      "reviewer_must_not_see_system_prediction": true,
      "reviewer_must_not_use_majority_vote_as_default": true,
      "reviewer_must_review_full_authoritative_transcript_for_evidence_gold": true
    },
    "decision_authority": {
      "routine_agreement": "accepted after initial annotation plus independent review",
      "unresolved_disagreement": "user adjudication",
      "final_human_decision": "user"
    },
    "review_outcomes": [
      "agree",
      "revise_gold",
      "escalate",
      "blocked_by_source"
    ]
  },
