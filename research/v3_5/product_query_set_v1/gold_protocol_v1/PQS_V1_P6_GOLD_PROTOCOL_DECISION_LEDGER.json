  "protocol_version": "PRODUCT_QUERY_GOLD_PROTOCOL_V1",
  "protocol_scope": {
    "freeze_retrieval_gold_definition": true,
    "freeze_evidence_gold_definition": true,
    "freeze_sufficiency_gold_definition": true,
    "freeze_review_and_adjudication": true,
    "freeze_frozen_gold_isolation": true,
    "freeze_reason_code_namespaces": true,
    "perform_annotation": false,
    "read_raw_transcripts": false,
    "read_existing_gold": false,
    "run_system_pipeline": false
  },
  "separation_contract": {
    "retrieval_gold_must_not_contain": [
      "evidence_spans",
      "required_aspects",
      "sufficiency_status",
      "builder_output",
      "selector_output",
      "system_rank",
      "expected_failure"
    ],
    "evidence_gold_must_not_contain": [
      "sufficiency_status",
      "system_prediction",
      "builder_miss",
      "selector_miss",
      "expected_failure"
    ],
    "sufficiency_gold_must_not_contain": [
      "system_prediction",
      "system_rank",
      "builder_miss",
      "selector_miss",
      "judge_prediction",
      "expected_failure"
    ],
    "system_failure_attribution_is_separate_from_gold": true
  },
  "retrieval_gold": {
    "evaluation_model": "bounded_pooled_judgment",
    "exhaustive": false,
    "known_relevant_video_ids": {
      "meaning": "Seed positives known through human corpus review before pooled addenda.",
      "constraint": "Must be a subset of acceptable_video_ids after final adjudication."
    },
    "acceptable_video_ids": {
      "meaning": "All videos explicitly judged capable of materially helping answer the query.",
      "constraint": "May contain multiple acceptable alternatives; no single target video is privileged."
    },
    "hard_negative_video_ids": {
      "meaning": "Explicitly reviewed near-miss videos that are topically plausible but materially fail relevance.",
      "constraint": "Must never be inferred merely from absence in the positive pool."
    },
    "relevance_review_scope": {
      "required": true,
      "minimum_fields": [
        "pool_version",
        "reviewed_video_ids",
        "pool_construction_method",
        "review_authority",
        "review_timestamp"
      ]
    },
    "unjudged_policy": {
      "non_pool_return": "unjudged",
      "automatic_negative": false,
      "required_action": "human_relevance_adjudication",
      "prediction_must_be_frozen_before_addendum": true
    },
    "development_pool_addendum": {
      "allowed": true,
      "versioned": true,
      "may_add_new_acceptables": true,
      "may_delete_existing_positive_to_improve_metric": false,
      "requires_independent_relevance_judgment": true
    },
    "relevance_definition": {
      "relevant": "The video contains authoritative content that materially supports at least one required aspect or is an acceptable navigation source to such authoritative content.",
      "acceptable_for_retrieval_metric": "The video materially contributes toward answering the user query, even if another video is also acceptable.",
      "hard_negative": "Topically close or lexically matching but materially unable to support any required aspect."
    }
  },
  "evidence_gold": {
    "authority": {
      "authoritative_sources": [
        "official_subtitle",
        "asr_transcript"
      ],
      "navigation_only_sources": [
        "title",
        "description",
        "ai_summary",
        "ai_chapter"
      ],
      "navigation_only_may_be_gold_evidence": false,
      "full_raw_transcript_review_required": true
    },
    "required_aspects": {
      "required": true,
      "fields": [
        "aspect_id",
        "description",
        "materiality",
        "query_text_basis"
      ],
      "materiality_values": [
        "material",
        "supporting"
      ],
      "default_materiality": "material"
    },
    "aspect_evidence_options": {
      "meaning": "For each aspect, alternative evidence sets are OR; spans inside one set are AND.",
      "required_for_supported_aspect": true
    },
    "acceptable_evidence_groups": {
      "between_groups": "OR",
      "within_group_required_span_sets": "AND",
      "may_span_multiple_videos": true,
      "may_combine_multiple_transcript_regions": true,
      "builder_output_may_limit_gold": false,
      "retrieval_output_may_limit_gold": false
    },
    "span_contract": {
      "required_fields": [
        "span_id",
        "video_id",
        "segment_ids",
        "start_time",
        "end_time",
        "quote_text",
        "source_language",
        "source_type",
        "source_version",
        "timeline_run_id",
        "segment_identity_version"
      ],
      "time_must_be_replayable": true,
      "segment_ids_must_be_replayable": true,
      "quote_must_be_verbatim_source_text": true,
      "translation_may_replace_source_text": false,
      "translated_gloss_optional": true
    },
    "required_spans": {
      "meaning": "Spans necessary for an aspect or complete acceptable evidence group.",
      "optional_context_may_replace_required_span": false
    },
    "optional_context_spans": {
      "meaning": "Helpful context that improves interpretation but is not necessary for support.",
      "may_determine_sufficiency_alone": false
    },
    "cross_language_policy": {
      "allowed": true,
      "source_language_preserved": true,
      "source_text_preserved": true,
      "translation_pipeline_required": false
    },
    "source_quality_flags": [
      "clean",
      "minor_asr_noise",
      "severe_asr_noise",
      "timeline_uncertain",
      "source_incomplete",
      "source_unavailable"
    ]
  },
  "sufficiency_gold": {
    "allowed_statuses": [
      "sufficient",
      "partial",
      "insufficient",
      "unverifiable"
    ],
    "decision_order": [
      "Determine whether authoritative material is reviewable enough to make a reliable content judgment.",
      "Determine support for each material required aspect.",
      "Apply sufficient / partial / insufficient; use unverifiable only when reliable review itself is not possible."
    ],
    "definitions": {
      "sufficient": {
        "meaning": "Every material required aspect is reliably supported by at least one acceptable evidence construction.",
        "supported_aspects": "All material aspects.",
        "missing_aspects": "None of the material aspects."
      },
      "partial": {
        "meaning": "At least one material required aspect is reliably supported, while at least one other material aspect is missing, unresolved, or blocked by source limitations.",
        "supported_aspects": "Non-empty material subset.",
        "missing_aspects": "Non-empty material subset."
      },
      "insufficient": {
        "meaning": "Authoritative source material is reviewable, but it provides no usable support for a meaningful material subset of the query.",
        "supported_aspects": "Empty, or only non-material/supporting details.",
        "missing_aspects": "All material aspects."
      },
      "unverifiable": {
        "meaning": "Authoritative source material is missing, damaged, inaccessible, identity-uncertain, or otherwise not reliably reviewable enough to make a content judgment.",
        "supported_aspects": "May be empty; any incidental support is not reliable enough for a Gold judgment.",
        "missing_aspects": "Unresolved because source authority or reviewability failed."
      }
    },
    "mixed_source_rule": {
      "some_material_aspects_reliably_supported_and_others_source_blocked": "partial",
      "no_material_aspect_reliably_judgable_due_to_source_failure": "unverifiable",
      "all_sources_reviewable_but_no_material_support": "insufficient"
    },
    "required_fields": [
      "query_id",
      "status",
      "supported_aspects",
      "missing_aspects",
      "reason_codes",
      "evidence_group_ids_used",
      "gold_policy_version"
    ],
    "confidence_is_not_a_label_substitute": true
  },
  "reason_code_registry": {
    "namespaces": {
      "retrieval_gold_state": [
        "RG_KNOWN_RELEVANT",
        "RG_ACCEPTABLE_ALTERNATIVE",
        "RG_HARD_NEGATIVE_EXPLICIT",
        "RG_UNJUDGED_OUTSIDE_POOL"
      ],
      "evidence_gold_state": [
