_000:seg_000096","bilibili:BV1pCGJ6ZEDH:run_000:seg_000097","bilibili:BV1pCGJ6ZEDH:run_000:seg_000098","bilibili:BV1pCGJ6ZEDH:run_000:seg_000099","bilibili:BV1pCGJ6ZEDH:run_000:seg_000100","bilibili:BV1pCGJ6ZEDH:run_000:seg_000101","bilibili:BV1pCGJ6ZEDH:run_000:seg_000102","bilibili:BV1pCGJ6ZEDH:run_000:seg_000103","bilibili:BV1pCGJ6ZEDH:run_000:seg_000104","bilibili:BV1pCGJ6ZEDH:run_000:seg_000105","bilibili:BV1pCGJ6ZEDH:run_000:seg_000106","bilibili:BV1pCGJ6ZEDH:run_000:seg_000107","bilibili:BV1pCGJ6ZEDH:run_000:seg_000108","bilibili:BV1pCGJ6ZEDH:run_000:seg_000109","bilibili:BV1pCGJ6ZEDH:run_000:seg_000110","bilibili:BV1pCGJ6ZEDH:run_000:seg_000111","bilibili:BV1pCGJ6ZEDH:run_000:seg_000112","bilibili:BV1pCGJ6ZEDH:run_000:seg_000113","bilibili:BV1pCGJ6ZEDH:run_000:seg_000114","bilibili:BV1pCGJ6ZEDH:run_000:seg_000115","bilibili:BV1pCGJ6ZEDH:run_000:seg_000116","bilibili:BV1pCGJ6ZEDH:run_000:seg_000117","bilibili:BV1pCGJ6ZEDH:run_000:seg_000118","bilibili:BV1pCGJ6ZEDH:run_000:seg_000119","bilibili:BV1pCGJ6ZEDH:run_000:seg_000120","bilibili:BV1pCGJ6ZEDH:run_000:seg_000121","bilibili:BV1pCGJ6ZEDH:run_000:seg_000122","bilibili:BV1pCGJ6ZEDH:run_000:seg_000123"],"start_time":180.63,"end_time":272.83,"quote_text":"第二种机制是丢条件 就算分组分对了 压缩文字时还是会出问题 每总结一次记忆都会被磨平一点 像一件事 被人反复转述 第一遍还有时间地点 前提转述几轮以后只剩下一句 听起来很通用的话 一条经验真正有用 常常靠的是它的使用条件 比如W8 原本应该是在搜索结果不匹配时可以翻下一页 但压缩以后很容易变成继续点next找更多商品 少了不匹配时 这个条件意思就变了 论文在一个家庭任务环境里也看到类似问题 有些任务只是相邻 不是同一个任务 比如拿起来再放好 和先清洁再放好 看起来相似 但关键步骤不一样 如果把前一个任务的经验硬套到后一个任务里 agent就会被带偏 在另一个科学任务环境里 这个问题更明显 论文比较了两种做法 一种只总结当前任务 另一种把前面所有任务不断合 并进同一个记忆库 到第15个任务以后 后面这种做法比只看当前任务低了203分 研究者再让模型去标注记忆内容 结果发现一路合并出来的记忆里 过度泛化的内容大约是只看当前任务的五倍 垃圾记忆大约是20倍 丢条件会把记忆库磨成一堆大而化之的句子 听起来有道理 用起来到处添乱","source_language":"zh","source_type":"official_subtitle","source_version":"2721c28d53c3b6058dc97e4eed9acc924e0d6906898f73502f923b110f3e14a3","timeline_run_id":"timeline_run_bee1e312373248baccf6d018ac286822cc3e95a2d097311781ed41aaa248c948","segment_identity_version":"v3.5-source-identity-v2","source_q