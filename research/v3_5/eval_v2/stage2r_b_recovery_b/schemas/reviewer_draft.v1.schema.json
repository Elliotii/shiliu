{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewerDraft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "required_aspects",
    "supported_aspect_indices",
    "missing_aspect_indices",
    "required_spans",
    "optional_context_spans",
    "evidence_groups",
    "reason_codes",
    "conflict_notes",
    "confidence",
    "boundary_notes"
  ],
  "properties": {
    "status": {
      "enum": ["sufficient", "partial", "insufficient", "unverifiable"]
    },
    "required_aspects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {"text": {"type": "string", "minLength": 1}}
      }
    },
    "supported_aspect_indices": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0},
      "uniqueItems": true
    },
    "missing_aspect_indices": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0},
      "uniqueItems": true
    },
    "required_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_ids", "supported_aspect_indices"],
        "properties": {
          "segment_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "supported_aspect_indices": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "optional_context_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_ids"],
        "properties": {
          "segment_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        }
      }
    },
    "evidence_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required_aspect_indices",
          "required_span_indices",
          "alternative_expression_notes"
        ],
        "properties": {
          "required_aspect_indices": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0}
          },
          "required_span_indices": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0}
          },
          "alternative_expression_notes": {"type": "string"}
        }
      }
    },
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "conflict_notes": {"type": "string"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "boundary_notes": {"type": "array", "items": {"type": "string"}}
  }
}
