  "runtime_registration": null,
  "active": false,
  "shadow": false,
  "attribution_identity": "V5D-S1-ATTRIBUTION-20260811-A",
  "hypothesis_identity": "V5D-S1-HYPOTHESIS-20260811-A",
  "failure_family": "non_progress_search_repetition_without_recovery",
  "applicability": {
    "mode": [
      "deep_research"
    ],
    "decision_phase": "pre_follow_up_action",
    "required_state": [
      "at_least_one_tool_observation_exists",
      "one_or_more_user_objective_evidence_requirements_remain_unresolved",
      "current_source_index_and_runtime_health_are_valid",
      "remaining_decision_and_tool_budget_is_known"
    ]
  },
  "non_applicable_scope": [
    "initial_query_planning_before_any_observation",
    "already_sufficient_grounded_answer",
    "provider_infrastructure_or_evaluator_invalid_run",
    "stale_missing_or_unready_source_or_index",
    "fast_answer_or_plain_search",
    "answer_presentation_citation_validation_or_evidence_authority",
    "tasks_without_an_unresolved_evidence_target_or_a_safe_honest_stop"
  ],
  "trigger": {
    "all": [
      "last_completed_action_was_evidence_seeking_or_empty_navigation_transcript_fallback",
      "last_action_current_transcript_evidence_delta_equals_zero",
      "user_objective_or_open_questions_still_identify_unresolved_evidence_work",
      "run_is_not_invalid_and_budget_is_not_exhausted"
    ],
    "termination_reason_dependency": false,
    "repeat_count_dependency": false
  },
  "required_preconditions": [
    "decision_view_exposes_last_observation_summary_previous_action_keys_visited_summary_open_questions_and_remaining_budget",
    "unresolved_targets_are_derived_only_from_user_objective_open_questions_and_current_routing_observations",
    "candidate_package_identity_and_lifecycle_status_are_valid",
    "treatment_is_explicitly_authorized_by_a_future_frozen_experiment",
    "candidate_has_no_gold_evaluator_split_reserve_or_promotion_access"
  ],
  "procedure": [
    {
      "step": 1,
      "action": "build_progress_snapshot",
      "fields": [
        "current_evidence_count",
        "current_citation_coverage",
        "visited_source_count",
        "previous_action_keys",
        "last_observation_summary",
        "unresolved_user_objective_requirements",
        "remaining_budget"
      ]
    },
    {
      "step": 2,
      "action": "classify_last_action_information_delta",
      "allowed_values": [
        "grounded_evidence_progress",
        "routing_only_progress",
        "no_grounded_progress"
      ],
      "rule": "navigation results are routing observations and never grounded evidence"
    },
    {
      "step": 3,
      "action": "derive_eligible_recovery_targets",
      "rule": "derive targets from unresolved user-objective requirements and current routing observations; exclude Gold, evaluator output, reserve metadata semantics and previously used exact action keys"
    },
    {
      "step": 4,
      "action": "select_at_most_one_bounded_recovery_action",
      "rule": "the action must be evidence-bearing, tied to one unresolved target, materially different in query scope or source target, within permissions and capable of adding current transcript evidence"
    },
    {
      "step": 5,
      "action": "reevaluate_or_honestly_stop",
      "rule": "after the bounded recovery, continue only when current grounded evidence increased and an answer remains feasible; otherwise stop partial when current evidence supports a bounded answer or insufficient when none does"
    }
  ],
  "stop_conditions": [
    "current_grounded_evidence_supports_the_bounded_user_objective_with_explicit_limitations",
    "no_untried_evidence_bearing_recovery_target_is_eligible",
    "one_candidate_recovery_action_completed_without_current_evidence_gain",
    "budget_deadline_permission_or_control_boundary_requires_stop",
    "provider_infrastructure_source_index_or_evaluator_state_becomes_invalid"
  ],
  "forbidden_behavior": [
    "repeat_an_exact_normalized_action_key",
    "use_rephrasing_only_when_scope_source_target_and_expected_evidence_are_unchanged",
    "treat_navigation_hit_count_answer_length_or_search_count_as_grounded_success",
    "derive_targets_from_gold_evaluator_outputs_split_labels_or_sealed_reserve_content",
    "modify_evidence_citation_currentness_verifier_authority_or_source_lineage",
    "expand_tool_permission_provider_route_or_corpus_scope",
    "continue_searching_when_no_eligible_recovery_target_exists",
    "hide_or_reclassify_provider_infrastructure_evaluation_or_implementation_invalid_runs"
  ],
  "baseline_fallback": {
    "behavior": "execute_the_existing_no_skill_baseline_unchanged",
    "required_when": [
      "candidate_package_missing_or_invalid",
      "candidate_not_explicitly_enabled_by_the_frozen_treatment",
      "applicability_or_preconditions_not_satisfied",
      "identity_lineage_or_protected_boundary_check_fails",
      "rollback_or_rejection_is_recorded"
    ]
  },
