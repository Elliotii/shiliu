{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shiliu private reference taxonomy",
  "type": "object",
  "required": ["version", "content_types", "domains"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "content_types": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "domains": {"type": "array", "items": {"$ref": "#/$defs/domain"}}
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "name", "definition", "includes", "excludes", "positive_examples", "negative_examples"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "includes": {"type": "array", "items": {"type": "string"}},
        "excludes": {"type": "array", "items": {"type": "string"}},
        "positive_examples": {"type": "array", "items": {"type": "string"}},
        "negative_examples": {"type": "array", "items": {"type": "string"}}
      }
    },
    "domain": {
      "allOf": [
        {"$ref": "#/$defs/node"},
        {
          "type": "object",
          "properties": {
            "children": {"type": "array", "items": {"$ref": "#/$defs/node"}}
          },
          "required": ["children"]
        }
      ]
    }
  }
}
